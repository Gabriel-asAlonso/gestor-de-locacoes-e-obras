# ---------------------------------------------------------------------------
# Backend configuration. Copy to `.env` and fill in real values.
# Never commit real secrets or database files. Values below are placeholders.
# ---------------------------------------------------------------------------

# Application
APP_ENV=development            # development | test | production
APP_HOST=127.0.0.1
APP_PORT=3001

# Front-end: public build-time setting; never put a secret in NEXT_PUBLIC_*.
# Same-origin /api in dev is forwarded to the separately running Hono backend.
NEXT_PUBLIC_API_URL=/api
API_PROXY_TARGET=http://127.0.0.1:3001
# For staging/production set NEXT_PUBLIC_API_URL when building, or route /api
# through your reverse proxy. Hosting only the frontend does not host SQLite/API.

# Database — SQLite is a local file, so there is NO host/port/user/password.
# (A network database would use DATABASE_HOST/PORT/NAME/USER/PASSWORD; not applicable here.)
DATABASE_PATH=./.data/locacoes.sqlite
UPLOADS_PATH=./.data/uploads

# Authentication (JWT). Required — the app refuses to start without these.
# Use long random strings (>= 32 chars), different for access and refresh. Do NOT reuse.
JWT_SECRET=troque-por-um-segredo-aleatorio-de-32-mais-caracteres
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=troque-por-outro-segredo-aleatorio-de-32-mais-caracteres
JWT_REFRESH_EXPIRES_IN=7d

# HTTP security
CORS_ORIGINS=                  # comma-separated allowed origins; required in production
LOG_LEVEL=info                 # debug | info | warn | error | critical
BODY_LIMIT_BYTES=12000000      # max request body size (supports files up to 10 MB)
AUTH_RATE_LIMIT_MAX=10         # max /auth/login and /auth/refresh attempts per window
AUTH_RATE_LIMIT_WINDOW_MS=60000

# Initial administrador (only used by `npm run db:create-admin`). Never hard-coded.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador
